# Local zero-config SQLite database (auto-created on startup or db:migrate)
DATABASE_URL="file:./data/app.db"

# Optional PostgreSQL connection string for production / Docker Compose
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/flowmind"

# Optional LLM API keys (app uses realistic local heuristic AI fallback if omitted)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# Ecosystem Signed Webhooks (HMAC-SHA256)
WEBHOOK_URL=
WEBHOOK_SECRET=portfolio-ecosystem-dev-secret
